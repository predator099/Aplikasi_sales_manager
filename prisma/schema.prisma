datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("Sales") // Administrator, Marketing, Sales, Manager, Finance, AM, NOC / Teknis, Super Admin
  avatarUrl String?
  status    String   @default("Aktif") // Aktif, Tidak Aktif
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@map("users")
}

model Customer {
  id                     String   @id @default(cuid())
  fullName               String
  nik                    String?
  companyName            String
  npwp                   String?
  nib                    String?
  npwpDocument           Json?
  nibDocument            Json?
  picPosition            String?
  whatsapp               String?
  email                  String?
  address                String?
  city                   String?
  province               String?
  postalCode             String?
  status                 String   @default("Prospek") // Aktif, Tidak Aktif, Suspended, Prospek
  notes                  String?
  salesName              String?
  salesPhone             String?
  picTechnicalPhone      String?
  picFinanceName         String?
  picFinancePhone        String?
  subscriptionPeriod     String?
  responsiblePerson      String?
  responsiblePersonPhone String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  services   ServiceItem[]
  quotations Quotation[]
  invoices   Invoice[]

  @@map("customers")
}

model Metro {
  id            String   @id @default(cuid())
  name          String
  bandwidthMbps Int?
  priceMethod   String   @default("Per Mbps") // Per Mbps, Per Gbps, Per 100 Mbps
  price         Float
  status        String   @default("Aktif") // Aktif, Tidak Aktif
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services   ServiceItem[]
  quotations Quotation[]

  @@map("metros")
}

model PublicIp {
  id        String   @id @default(cuid())
  prefix    String
  price     Float
  status    String   @default("Aktif") // Aktif, Tidak Aktif
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services   ServiceItem[]
  quotations Quotation[]

  @@map("public_ips")
}

model BandwidthTier {
  id            String   @id @default(cuid())
  bandwidthMbps Int      @unique
  name          String
  price         Float
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bandwidth_tiers")
}

model PricingConfig {
  id                      String   @id @default("BASE-PRICING")
  internetPricePer100Mbps Float    @default(3000000)
  ppnPercentage           Float    @default(11)
  minBandwidthMbps        Int      @default(100)
  maxBandwidthMbps        Int      @default(20000)
  bandwidthStepMbps       Int      @default(100)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("pricing_configs")
}

model CalculationFormulaConfig {
  id                         String   @id @default("FORMULA-DEFAULT-v1")
  internetCalculationMethod  String   @default("tier_priority_fallback")
  internetFallbackPer100Mbps Float    @default(3000000)
  internetFallbackPerMbps    Float    @default(30000)
  ppnPercentage              Float    @default(11)
  maxDiscountPercentage      Float    @default(50)
  metroCalculationMethod     String   @default("proportional_capacity")
  metroMultiplierRatio       Float    @default(1.0)
  metroRoundingRule          String   @default("none")
  metroMinimumPrice          Float    @default(0)
  kantorPercentage           Float    @default(60)
  marketingPoolPercentage    Float    @default(40)
  salesPercentageOfPool      Float    @default(75)
  amPercentageOfPool         Float    @default(25)
  minimumMarginForFee        Float    @default(0)
  enableSalesBonus           Boolean  @default(false)
  bonusThresholdMargin       Float    @default(5000000)
  salesBonusPercentage       Float    @default(5)
  userFeeRates               Json?
  updatedBy                  String   @default("Administrator")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("formula_configs")
}

model ServiceItem {
  id                String    @id @default(cuid())
  customerId        String
  bandwidthMbps     Int
  metroId           String?
  publicIpId        String?
  discountType      String    @default("nominal") // nominal, percentage
  discountValue     Float     @default(0)
  notes             String?
  internetCost      Float     @default(0)
  metroCost         Float     @default(0)
  publicIpCost      Float     @default(0)
  subtotal          Float     @default(0)
  discountAmount    Float     @default(0)
  dpp               Float     @default(0)
  ppnAmount         Float     @default(0)
  totalMonthly      Float     @default(0)
  pricingAllocation Json?
  status            String    @default("Aktif") // Aktif, Nonaktif, Suspended
  datekDoc          Json?
  bastDoc           Json?
  activationDate    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  metro    Metro?     @relation(fields: [metroId], references: [id])
  publicIp PublicIp?  @relation(fields: [publicIpId], references: [id])
  invoices Invoice[]
  quotations Quotation[]

  @@map("service_items")
}

model Quotation {
  id                String       @id @default(cuid())
  date              String
  customerId        String
  serviceId         String?
  bandwidthMbps     Int
  metroId           String?
  publicIpId        String?
  internetCost      Float        @default(0)
  metroCost         Float        @default(0)
  publicIpCost      Float        @default(0)
  subtotal          Float        @default(0)
  discountType      String       @default("nominal")
  discountValue     Float        @default(0)
  discountAmount    Float        @default(0)
  dpp               Float        @default(0)
  ppnAmount         Float        @default(0)
  total             Float        @default(0)
  pricingAllocation Json?
  status            String       @default("Draft") // Draft, Sent, Accepted, Rejected, Expired
  notes             String?
  validUntil        String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  ServiceItem? @relation(fields: [serviceId], references: [id])
  metro    Metro?       @relation(fields: [metroId], references: [id])
  publicIp PublicIp?    @relation(fields: [publicIpId], references: [id])
  invoices Invoice[]

  @@map("quotations")
}

model Invoice {
  id                 String          @id @default(cuid())
  customerId         String
  serviceId          String?
  quotationId        String?
  serviceDescription String
  billingPeriod      String
  issueDate          String
  dueDate            String
  subtotal           Float           @default(0)
  discountAmount     Float           @default(0)
  dpp                Float           @default(0)
  ppnAmount          Float           @default(0)
  total              Float           @default(0)
  paidAmount         Float           @default(0)
  paymentStatus      String          @default("Unpaid") // Draft, Unpaid, Partially Paid, Paid, Overdue, Cancelled
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  ServiceItem?   @relation(fields: [serviceId], references: [id])
  quotation Quotation?    @relation(fields: [quotationId], references: [id])
  payments PaymentRecord[]

  @@map("invoices")
}

model PaymentRecord {
  id              String   @id @default(cuid())
  invoiceId       String
  date            String
  amount          Float
  paymentMethod   String
  referenceNumber String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model FeeWithdrawalRecord {
  id            String   @id @default(cuid())
  serviceId     String?
  customerName  String?
  recipientName String
  recipientRole String   // Sales, AM, Marketing
  amount        Float
  date          String
  status        String   @default("Pending") // Pending, Approved, Paid, Rejected
  paymentDate   String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("fee_withdrawals")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  timestamp   DateTime @default(now())
  user        String
  userName    String
  role        String
  userRole    String
  action      String
  module      String
  recordId    String?
  description String?
  details     String
  ipAddress   String?
  createdAt   DateTime @default(now())

  userRef User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
